rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner() {
      return isAuthenticated() && (request.auth.token.role == 'owner' || request.auth.token.role == 'admin');
    }
    
    function isStaff() {
      return isAuthenticated() && (request.auth.token.role == 'owner' || request.auth.token.role == 'admin' || request.auth.token.role == 'manager' || request.auth.token.role == 'staff');
    }

    // Products: Anyone can read, only staff/owner can write
    match /products/{productId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Orders: Customers can read/create their own orders; Staff can read/update all orders
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isStaff());
      allow create: if isAuthenticated();
      allow update, delete: if isStaff();
    }

    // Coupons: Public read for active coupons, write restricted to staff
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // User profiles & addresses
    match /users/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isOwner());
      
      match /addresses/{addressId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isOwner());
      }
    }

    // Admins collection lookup for RBAC fallback
    match /admins/{adminId} {
      allow read: if isAuthenticated() && (request.auth.uid == adminId || isOwner());
      allow write: if isOwner();
    }

    // Reviews: Anyone can read approved, authenticated users can write reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isStaff();
    }
  }
}
