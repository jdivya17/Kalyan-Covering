rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Security Helper Functions ---
    
    // Check if the user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if the user has an admin role (via custom claims)
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'owner' || 
        request.auth.token.role == 'manager' || 
        request.auth.token.role == 'staff'
      );
    }
    
    // Check if the user is owner or manager (for sensitive operations)
    function isOwnerOrManager() {
      return isAuthenticated() && (
        request.auth.token.role == 'owner' || 
        request.auth.token.role == 'manager'
      );
    }
    
    // Check if the user is requesting their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- Publicly Readable Collections ---
    
    match /categories/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /products/{document=**} {
      allow read: if true;
      allow write: if isAdmin() && 
                   (!('price' in request.resource.data) || request.resource.data.price is number) &&
                   (!('mrp' in request.resource.data) || request.resource.data.mrp is number);
    }
    
    match /brands/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /branches/{document=**} {
      allow read: if true;
      allow write: if isOwnerOrManager();
    }
    
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isOwnerOrManager();
    }

    match /config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /videos/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // --- Coupons: Authenticated users only (prevents unauthenticated scraping) ---
    // Coupon validation on the frontend goes through the validateCoupon Cloud Function,
    // which does its own server-side auth check. Direct coupon reads are limited to
    // signed-in users only.
    match /coupons/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isOwnerOrManager();
    }
    
    match /reviews/{document=**} {
      allow read: if true;
      // Reviews must be submitted via Cloud Function to ensure one-review-per-order validation.
      allow create: if false;
      // Users can edit ONLY review content fields on their own reviews.
      // Prevents tampering with customerId, userId, productId, orderId, or any other metadata.
      allow update: if isAdmin() || (
        isAuthenticated() && 
        (resource.data.customerId == request.auth.uid || resource.data.userId == request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['rating', 'comment', 'reviewText', 'reviewerName', 'images', 'title', 'updatedAt'])
      );
      allow delete: if isAdmin() || (isAuthenticated() && (resource.data.customerId == request.auth.uid || resource.data.userId == request.auth.uid));
    }

    // --- Protected User Collections ---
    
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      // Admins can do anything. Users can create their own profile but cannot grant themselves admin roles.
      allow create: if isAdmin() || (
        isOwner(userId) && 
        request.resource.data.role == 'customer' && 
        request.resource.data.status == 'active' &&
        (!('phoneNumber' in request.resource.data) || request.resource.data.phoneNumber == request.auth.token.phone_number)
      );
      
      // Users can update their profile but cannot change their role, status, or fake a phone number.
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'status']) == false &&
        (!('phoneNumber' in request.resource.data) || 
          request.resource.data.phoneNumber == resource.data.phoneNumber ||
          request.resource.data.phoneNumber == request.auth.token.phone_number)
      );
      
      allow delete: if isAdmin();

      // Allow users to manage their address book subcollection
      match /addresses/{addressId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
    
    match /carts/{userId} {
      // Carts are 1-to-1 with the user ID
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    match /orders/{orderId} {
      // Users can only view their own orders; admins can view all.
      allow read: if isAdmin() || (isAuthenticated() && resource.data.customerId == request.auth.uid);

      // Orders are created exclusively via the createRazorpayOrder Cloud Function.
      // No client-side order creation is permitted.
      allow create: if false;

      // Admin can update order status, tracking info, etc. from the admin panel.
      // Customer-initiated cancel/return flow goes through cancelOrder and
      // initiateReturn Cloud Functions (which run with Admin SDK) — not direct writes.
      allow update: if isAdmin();

      // Only owner or manager can delete orders.
      allow delete: if isOwnerOrManager();
    }

    match /returns/{returnId} {
      // Users can only view their own return requests; admins can view all.
      allow read: if isAdmin() || (isAuthenticated() && resource.data.customerId == request.auth.uid);

      // Returns are created exclusively via the initiateReturn Cloud Function.
      allow write: if false;
    }
    
    match /wishlists/{userId} {
      // Wishlists are 1-to-1 with the user ID
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    match /notifications/{notificationId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      // Allow users to update their own notifications (e.g. mark as read)
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow create, delete: if isAdmin();
    }

    // --- Audit Logs (Owner-only read, no client writes) ---
    
    match /audit_logs/{logId} {
      // Only the owner role can read audit logs
      allow read: if isAuthenticated() && request.auth.token.role == 'owner';
      // No one can write directly from the client — only Cloud Functions or Admin SDK
      allow write: if false;
    }
    
    match /inventory_history/{historyId} {
      // Only the owner role can read inventory history directly from client
      allow read: if isAuthenticated() && request.auth.token.role == 'owner';
      allow write: if false;
    }
    
    // --- Invoices (read: owner or admin; write: Cloud Functions only) ---
    
    match /invoices/{invoiceId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow write: if false; // Managed exclusively by Cloud Functions
    }


    match /shipment_staging/{orderId} {
      // Idempotency staging records used exclusively by Cloud Functions (shippingService).
      // No direct client access is permitted.
      allow read, write: if false;
    }

    match /webhook_events/{id} {
      allow read, write: if false;
    }


    // Catch-all: Deny all access to any unspecified collection.
    // This is an explicit security boundary — any new collection must be
    // explicitly added above to be accessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
