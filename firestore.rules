rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner() {
      return isAuthenticated() && (request.auth.token.role == 'owner' || request.auth.token.role == 'admin');
    }
    
    function isStaff() {
      return isAuthenticated() && (request.auth.token.role == 'owner' || request.auth.token.role == 'admin' || request.auth.token.role == 'manager' || request.auth.token.role == 'staff');
    }

    // Products: Anyone can read, only staff/owner can write
    match /products/{productId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Orders: Customers can read their own orders (customerId); Staff can read/update/delete all orders. Client order creation is disabled.
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.customerId || isStaff());
      allow create: if false;
      allow update, delete: if isStaff();
    }

    // Coupons: Public read for active coupons, write restricted to staff
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // User profiles & addresses
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isOwner());
      allow create: if isAuthenticated() && request.auth.uid == userId
                    && !('role' in request.resource.data);
      allow update: if isOwner() || (
                      isAuthenticated() && request.auth.uid == userId
                      && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
                    );
      allow delete: if isOwner();

      match /addresses/{addressId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isOwner());
      }
    }

    // Admins collection lookup for RBAC fallback
    match /admins/{adminId} {
      allow read: if isAuthenticated() && (request.auth.uid == adminId || isOwner());
      allow write: if isOwner();
    }

    // Reviews: Anyone can read, authenticated users can create their own review (must be status 'pending')
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated()
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.status == 'pending';
      allow update, delete: if isStaff();
    }

    match /branches/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /config/social {
      allow read: if true;
    }
    match /config/{docId} {
      allow read: if isStaff();
      allow write: if isOwner();
    }

    match /settings/{docId} {
      allow read: if isStaff();
      allow write: if isOwner();
    }

    match /videos/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /stockAlerts/{id} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isStaff();
    }
    match /stock_alerts/{id} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isStaff();
    }

    match /audit_logs/{id} {
      allow read, create: if isStaff();
      allow update, delete: if false;
    }

    match /invoices/{id} {
      allow read: if isAuthenticated() && (resource.data.customerId == request.auth.uid || isStaff());
      allow write: if isStaff();
    }
  }
}
